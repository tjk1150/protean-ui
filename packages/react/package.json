{
  "name": "@protean-ui/react",
  "version": "0.1.0-alpha.2",
  "description": "Semantic adaptive components for React, driven by the Protean policy engine",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjk1150/protean-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/tjk1150/protean-ui",
  "keywords": [
    "adaptive",
    "responsive",
    "react",
    "components",
    "dialog",
    "bottom-sheet",
    "navigation",
    "design-system"
  ],
  "sideEffects": [
    "./reference.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./reference.css": "./reference.css",
    "./dialog": "./src/overlay/index.parts.ts",
    "./select": "./src/select/index.parts.ts",
    "./menu": "./src/menu/index.parts.ts",
    "./tooltip": "./src/tooltip/index.parts.ts",
    "./navigation": "./src/navigation/index.parts.ts",
    "./screen": "./src/screen/index.parts.ts",
    "./primary-action": "./src/primary-action/index.parts.ts",
    "./boundary": "./src/boundary.tsx",
    "./provider": "./src/provider.tsx",
    "./list-detail": "./src/list-detail/index.parts.ts"
  },
  "files": [
    "dist",
    "reference.css",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./reference.css": "./reference.css",
      "./dialog": {
        "types": "./dist/overlay/index.parts.d.ts",
        "default": "./dist/overlay/index.parts.js"
      },
      "./select": {
        "types": "./dist/select/index.parts.d.ts",
        "default": "./dist/select/index.parts.js"
      },
      "./menu": {
        "types": "./dist/menu/index.parts.d.ts",
        "default": "./dist/menu/index.parts.js"
      },
      "./tooltip": {
        "types": "./dist/tooltip/index.parts.d.ts",
        "default": "./dist/tooltip/index.parts.js"
      },
      "./navigation": {
        "types": "./dist/navigation/index.parts.d.ts",
        "default": "./dist/navigation/index.parts.js"
      },
      "./screen": {
        "types": "./dist/screen/index.parts.d.ts",
        "default": "./dist/screen/index.parts.js"
      },
      "./primary-action": {
        "types": "./dist/primary-action/index.parts.d.ts",
        "default": "./dist/primary-action/index.parts.js"
      },
      "./boundary": {
        "types": "./dist/boundary.d.ts",
        "default": "./dist/boundary.js"
      },
      "./provider": {
        "types": "./dist/provider.d.ts",
        "default": "./dist/provider.js"
      },
      "./list-detail": {
        "types": "./dist/list-detail/index.parts.d.ts",
        "default": "./dist/list-detail/index.parts.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/add-js-extensions.mjs dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@protean-ui/core": "workspace:*",
    "@protean-ui/css": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
