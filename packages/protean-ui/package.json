{
  "name": "protean-ui",
  "version": "0.1.0-alpha.4",
  "description": "Adaptive UI runtime for React: declare what the UI means, let a policy decide how it presents. Umbrella for @protean-ui/react.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjk1150/protean-ui.git",
    "directory": "packages/protean-ui"
  },
  "homepage": "https://github.com/tjk1150/protean-ui",
  "keywords": [
    "adaptive",
    "responsive",
    "react",
    "components",
    "design-system"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/add-js-extensions.mjs dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@protean-ui/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.0"
  }
}
